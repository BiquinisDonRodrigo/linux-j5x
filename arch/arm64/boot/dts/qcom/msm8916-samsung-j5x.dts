/dts-v1/;

#include "msm8916-samsung-j5-common.dtsi"

/ {
	model = "Samsung Galaxy J5 (2016)";
	compatible = "samsung,j5x", "qcom,msm8916";
	chassis-type = "handset";

	haptic {
		compatible = "regulator-haptic";
		haptic-supply = <&reg_motor_vdd>;
		min-microvolt = <3300000>;
		max-microvolt = <3300000>;
	};

	i2c-fuel-gauge {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 16 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 17 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;

		pinctrl-0 = <&fg_i2c_default>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		fuel-gauge@71 {
			compatible = "siliconmitus,sm5703-fg";
			reg = <0x71>;

			interrupts-extended = <&tlmm 21 IRQ_TYPE_EDGE_FALLING>;

			pinctrl-0 = <&fg_int_default>;
			pinctrl-names = "default";
		};
	};

	i2c-pmic {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 22 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 23 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;

		pinctrl-0 = <&pmic_i2c_default>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		pmic@49 {
			compatible = "siliconmitus,sm5703-mfd";
			reg = <0x49>;

			interrupts-extended = <&tlmm 62 IRQ_TYPE_EDGE_FALLING>;
			reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;

			pinctrl-0 = <&pmic_int_default &pmic_reset_default>;
			pinctrl-names = "default";

			regulators {
				reg_motor_vdd: ldo2 {
					regulator-name = "motor_vdd";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
				};
			};
		};
	};

	i2c-touchkey {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 101 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 102 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;

		pinctrl-0 = <&tkey_i2c_default>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		touchkey@20 {
			compatible = "coreriver,tc350k-touchkey";
			reg = <0x20>;

			interrupts-extended = <&tlmm 98 IRQ_TYPE_EDGE_FALLING>;

			vcc-supply = <&reg_touch_key>;
			linux,keycodes = <KEY_APPSELECT KEY_BACK>;

			pinctrl-0 = <&tkey_int_default>;
			pinctrl-names = "default";
		};
	};

	reg_touch_key: regulator-touch-key {
		compatible = "regulator-fixed";
		regulator-name = "touch_key";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&tlmm 120 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&tkey_en_default>;
		pinctrl-names = "default";
	};

	reg_vdd_lcd_3p0: regulator-vdd-lcd-3p0 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_lcd_3p0";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;

		gpio = <&tlmm 115 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&lcd_3p0_ldo_en_default>;
		pinctrl-names = "default";
	};

	reg_vdd_tsp_a: regulator-vdd-tsp-a {
		compatible = "regulator-fixed";
		regulator-name = "vdd_tsp_a";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;

		gpio = <&tlmm 108 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&tsp_ldo_en_default>;
		pinctrl-names = "default";
	};

	reg_vdd_prox_led: regulator-vdd-prox-led {
		compatible = "regulator-fixed";
		regulator-name = "vdd_prox_led";

		gpio = <&tlmm 97 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&prox_led_en_default>;
		pinctrl-names = "default";
	};
};

&accelerometer {
	interrupts-extended = <&tlmm 49 IRQ_TYPE_LEVEL_HIGH>;

	vdd-supply = <&pm8916_l6>;
	vddio-supply = <&pm8916_l6>;

	mount-matrix = "0", "-1", "0",
		       "1", "0", "0",
		       "0", "0", "-1";
};

&front_flash_led {
	ctrl-gpios = <&tlmm 85 GPIO_ACTIVE_HIGH>;
};

&i2c_sensors {
	proximity@60 {
		compatible = "capella,cm36672p";
		reg = <0x60>;

		interrupts-extended = <&tlmm 20 IRQ_TYPE_EDGE_FALLING>;
		proximity-near-level = <17>;

		vdd-supply = <&pm8916_l17>;
		vio-supply = <&pm8916_l6>;
		vled-supply = <&reg_vdd_prox_led>;

		pinctrl-0 = <&prox_int_default>;
		pinctrl-names = "default";
	};
};

&muic {
	interrupts = <121 IRQ_TYPE_EDGE_FALLING>;
};

&panel {
	compatible = "samsung,s6e8aa5x01-ams520kt01";
	vdd3-supply = <&reg_vdd_lcd_1p8>;
	vci-supply = <&reg_vdd_lcd_3p0>;
};

&reg_vdd_lcd_1p8 {
	gpio = <&tlmm 69 GPIO_ACTIVE_HIGH>;
};

&touchscreen {
	vdd-supply = <&reg_vdd_tsp_a>;
};

&tlmm {
	fg_i2c_default: fg-i2c-default-state {
		pins = "gpio16", "gpio17";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	fg_int_default: fg-int-default-state {
		pins = "gpio21";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	lcd_3p0_ldo_en_default: lcd-3p0-ldo-en-default-state {
		pins = "gpio115";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	pmic_i2c_default: pmic-i2c-default-state {
		pins = "gpio22", "gpio23";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	pmic_int_default: pmic-int-default-state {
		pins = "gpio62";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	pmic_reset_default: pmic-reset-default-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	prox_int_default: prox-int-default-state {
		pins = "gpio20";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	prox_led_en_default: prox-led-en-default-state {
		pins = "gpio97";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	tkey_en_default: tkey-en-default-state {
		pins = "gpio120";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	tkey_i2c_default: tkey-i2c-default-state {
		pins = "gpio101", "gpio102";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	tkey_int_default: tkey-int-default-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	tsp_ldo_en_default: tsp-ldo-en-default-state {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&accel_int_default {
	pins = "gpio49";
};

&lcd_1p8_ldo_en_default {
	pins = "gpio69";
};

&muic_int_default {
	pins = "gpio121";
};

&vtcam_flash_en_default {
	pins = "gpio85";
};
